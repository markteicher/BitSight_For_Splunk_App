<?xml version="1.0"?>
<!--
=============================================================================
File Name:
    bitsight_asset_inventory_ciso_view.xml

View Name:
    BitSight Asset Inventory – Executive (CISO)

Version:
    1.0.0
=============================================================================

PURPOSE

Provide a complete, clear, and self-explanatory view of BitSight asset data
so a CISO or auditor can review external assets, ownership, geographic
distribution, lifecycle, exposure, governance, and data quality.

This view is designed so a third-party reviewer can understand the dataset
without additional explanation.

DATA SOURCE

bitsight_with_full_whois.csv

KEY FIELD

Value (IP address or CIDR range)

HOW TO READ

- Each row represents one asset (IP or CIDR)
- "Start Date" = first time the asset was observed
- "End Date" = last time observed (if no longer active)
- "Is Active" = current state
- "Attributed To" = ownership
- "CIDR Size" = size of network range (exposure)
- "Country" = geographic location

TIME PANELS

Time-based panels show when assets were first seen.
They show new assets, not total inventory change.

=============================================================================
-->
<dashboard version="1.1">

  <!--
  BASE SEARCH

  Purpose:
  - Load dataset
  - Convert Start Date to epoch
  - Calculate age in days
  - Assign age buckets for reporting

  Used by all panels to keep results consistent.
  -->
  <search id="base_bitsight">
    <query>
      | inputlookup bitsight_with_full_whois.csv
      | eval start_epoch=strptime('Start Date', "%Y-%m-%d")
      | eval age_days=floor((now()-start_epoch)/86400)
      | eval age_bucket=case(
          age_days < 30,"0-29d",
          age_days < 60,"30-59d",
          age_days < 90,"60-89d",
          age_days < 180,"90-179d",
          age_days < 365,"180-364d",
          age_days < 730,"1y",
          age_days < 1095,"2y",
          age_days < 1460,"3y",
          age_days < 1825,"4y",
          age_days < 2190,"5y",
          age_days >= 2190,"5y+"
      )
    </query>
  </search>

  <!-- ROW 1: Overall size and status -->
  <row>

    <!-- Total number of assets -->
    <panel>
      <title>Total Assets</title>
      <single>
        <search base="base_bitsight">
          <query>| stats count</query>
        </search>
      </single>
    </panel>

    <!-- Active vs inactive assets -->
    <panel>
      <title>Active vs Inactive</title>
      <table>
        <search base="base_bitsight">
          <query>| stats count by "Is Active"</query>
        </search>
      </table>
    </panel>

  </row>

  <!-- ROW 2: Distribution -->
  <row>

    <!-- Assets by country -->
    <panel>
      <title>Geographic Distribution</title>
      <table>
        <search base="base_bitsight">
          <query>| stats count by Country | sort - count</query>
        </search>
      </table>
    </panel>

    <!-- Assets by ownership -->
    <panel>
      <title>Ownership Distribution</title>
      <table>
        <search base="base_bitsight">
          <query>| stats count by "Attributed To" | sort - count</query>
        </search>
      </table>
    </panel>

  </row>

  <!-- ROW 3: Age and exposure -->
  <row>

    <!-- Asset age buckets -->
    <panel>
      <title>Asset Age Distribution</title>
      <table>
        <search base="base_bitsight">
          <query>| stats count by age_bucket</query>
        </search>
      </table>
    </panel>

    <!-- Largest network ranges -->
    <panel>
      <title>Largest Network Ranges</title>
      <table>
        <search base="base_bitsight">
          <query>| sort - "CIDR Size" | head 10</query>
        </search>
      </table>
    </panel>

  </row>

  <!-- ROW 4: New assets over time -->
  <row>

    <!-- New assets per day -->
    <panel>
      <title>New Assets Day over Day</title>
      <table>
        <search base="base_bitsight">
          <query>
            | eval _time=strptime('Start Date', "%Y-%m-%d")
            | timechart span=1d count as new_assets
            | delta new_assets as change
          </query>
        </search>
      </table>
    </panel>

    <!-- New assets per week -->
    <panel>
      <title>New Assets Week over Week</title>
      <table>
        <search base="base_bitsight">
          <query>
            | eval _time=strptime('Start Date', "%Y-%m-%d")
            | timechart span=1w count as new_assets
            | delta new_assets as change
          </query>
        </search>
      </table>
    </panel>

  </row>

  <!-- ROW 5 -->
  <row>

    <!-- New assets per month -->
    <panel>
      <title>New Assets Month over Month</title>
      <table>
        <search base="base_bitsight">
          <query>
            | eval _time=strptime('Start Date', "%Y-%m-%d")
            | timechart span=1mon count as new_assets
            | delta new_assets as change
          </query>
        </search>
      </table>
    </panel>

  </row>

  <!-- ROW 6: Age signals -->
  <row>

    <!-- New vs older assets -->
    <panel>
      <title>New vs Older Assets</title>
      <table>
        <search base="base_bitsight">
          <query>| eval asset_age=if(age_days<90,"New","Older") | stats count by asset_age</query>
        </search>
      </table>
    </panel>

    <!-- Recently added assets -->
    <panel>
      <title>Recently Added Assets</title>
      <table>
        <search base="base_bitsight">
          <query>| where age_days < 30 | stats count</query>
        </search>
      </table>
    </panel>

  </row>

  <!-- ROW 7 -->
  <row>

    <!-- Old active assets -->
    <panel>
      <title>Old Active Assets</title>
      <table>
        <search base="base_bitsight">
          <query>| where "Is Active"="TRUE" AND age_days > 365 | stats count</query>
        </search>
      </table>
    </panel>

    <!-- Assets with end date -->
    <panel>
      <title>Assets With End Dates</title>
      <table>
        <search base="base_bitsight">
          <query>| where 'End Date'!="" | stats count</query>
        </search>
      </table>
    </panel>

  </row>

  <!-- ROW 8: Infrastructure -->
  <row>

    <!-- ASN distribution -->
    <panel>
      <title>Assets by ASN</title>
      <table>
        <search base="base_bitsight">
          <query>| stats count by "AS Number" | sort - count</query>
        </search>
      </table>
    </panel>

    <!-- Tags distribution -->
    <panel>
      <title>Assets by Tags</title>
      <table>
        <search base="base_bitsight">
          <query>| stats count by Tags | sort - count</query>
        </search>
      </table>
    </panel>

  </row>

  <!-- ROW 9: Exposure -->
  <row>

    <!-- Exposure by owner -->
    <panel>
      <title>Exposure by Owner</title>
      <table>
        <search base="base_bitsight">
          <query>| stats sum("CIDR Size") as exposure by "Attributed To" | sort - exposure</query>
        </search>
      </table>
    </panel>

    <!-- Exposure by country -->
    <panel>
      <title>Exposure by Country</title>
      <table>
        <search base="base_bitsight">
          <query>| stats sum("CIDR Size") as exposure by Country | sort - exposure</query>
        </search>
      </table>
    </panel>

  </row>

  <!-- ROW 10 -->
  <row>

    <!-- Exposure by ASN -->
    <panel>
      <title>Exposure by ASN</title>
      <table>
        <search base="base_bitsight">
          <query>| stats sum("CIDR Size") as exposure by "AS Number" | sort - exposure</query>
        </search>
      </table>
    </panel>

    <!-- Grace period -->
    <panel>
      <title>Grace Period Status</title>
      <table>
        <search base="base_bitsight">
          <query>| stats count by "Grace Period"</query>
        </search>
      </table>
    </panel>

  </row>

  <!-- ROW 11 -->
  <row>

    <!-- Delegated controls -->
    <panel>
      <title>Delegated Controls</title>
      <table>
        <search base="base_bitsight">
          <query>| stats count by "Has Delegated Controls"</query>
        </search>
      </table>
    </panel>

    <!-- Missing ownership -->
    <panel>
      <title>Missing Ownership</title>
      <table>
        <search base="base_bitsight">
          <query>| eval status=if(isnull('Attributed To') OR 'Attributed To'="","Missing","Present") | stats count by status</query>
        </search>
      </table>
    </panel>

  </row>

  <!-- ROW 12 -->
  <row>

    <!-- Missing country -->
    <panel>
      <title>Missing Country</title>
      <table>
        <search base="base_bitsight">
          <query>| eval status=if(isnull(Country) OR Country="","Missing","Present") | stats count by status</query>
        </search>
      </table>
    </panel>

    <!-- Full detail -->
    <panel>
      <title>Detailed Asset View</title>
      <table>
        <search base="base_bitsight">
          <query>| sort 0 "Start Date"</query>
        </search>
      </table>
    </panel>

  </row>

</dashboard>
